# VIVAD environment (optional). The backend also reads the repository-root .env.
# With no AI keys VIVAD runs deterministically and shows "AI UNAVAILABLE".

# AI: Gemini is preferred, Groq is the fallback. Leave both empty to run without AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=60
AI_MAX_CALLS=6

# Sessions
AUTH_SECRET=change-me
SESSION_HOURS=12

# Video hearings: "jitsi" (default, no key) or "local" (offline mock room)
VIDEO_PROVIDER=jitsi

# Storage / limits
# VIVAD_DATA_DIR=./vivad/data
# VIVAD_REPORT_DIR=./vivad/reports
MAX_UPLOAD_MB=50

# Integrity anchoring (optional; only hashes would ever be published)
# BLOCKCHAIN_RPC_URL=
# BLOCKCHAIN_PRIVATE_KEY=
